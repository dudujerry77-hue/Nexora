// Nexora relational schema.
//
// Datasource is SQLite for zero-setup local dev/tests. To run against
// Postgres in production: change `provider` below to "postgresql", point
// DATABASE_URL at a Postgres instance, and (optionally) convert the string
// "enum-like" fields marked below into native Prisma `enum`s — SQLite does
// not support Prisma enums, so this schema documents allowed values in
// comments and enforces them with Zod at the application layer instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: "OWNER" | "STAFF" | "SUPER_ADMIN"
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // http(s) URL or a small data: URL (device upload) — same accepted shapes
  // as a product image, see productImageSchema in src/lib/validation.ts.
  // Null renders as the existing initials avatar.
  avatarUrl    String?
  role         String   @default("OWNER")
  createdAt    DateTime @default(now())

  ownedOrganizations Organization[] @relation("OrgOwner")
  memberships        Member[]
  auditLogs          AuditLog[]

  @@index([role])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members          Member[]
  stores           Store[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  monitoringIssues MonitoringIssue[]

  @@index([ownerId])
}

// role: "OWNER" | "STAFF"; status: "active" | "invited" | "suspended"
model Member {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("STAFF")
  status         String   @default("active")
  createdAt      DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  storeAssignments StoreAssignment[]

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model StoreAssignment {
  id          String   @id @default(cuid())
  memberId    String
  storeId     String
  // JSON: { viewOrders, manageOrders, viewProducts, manageProducts, viewCustomers }
  permissions String
  createdAt   DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])

  @@unique([memberId, storeId])
  @@index([storeId])
}

// type: "restaurant" | "fashion" | "retail" | "electronics" | "other"
// status: "connected" | "warning" | "disconnected"
// productMode: "nexora_managed" (create/edit products in this dashboard) |
//              "developer_owned" (the developer's own system is the source
//              of truth; products arrive via the existing API/webhook push
//              paths — see docs/INTEGRATIONS.md "Product ownership modes")
// pushDefaultMode: the Products page's main Push control's default
// behavior for this store — "push_all" | "push_selected" | "push" (the
// last one means the button opens the Push All/Push Selected options
// instead of acting immediately) — see src/lib/productPushService.ts.
// Per-store, never global.
model Store {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  logoUrl         String?
  type            String    @default("other")
  status          String    @default("disconnected")
  productMode     String    @default("nexora_managed")
  pushDefaultMode String    @default("push")
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  integrations     Integration[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  orders           Order[]
  products         Product[]
  inventory        Inventory[]
  customers        Customer[]
  notifications    Notification[]
  integrationLogs  IntegrationLog[]
  storeAssignments StoreAssignment[]
  monitoringIssues MonitoringIssue[]
  monitoringEvents MonitoringEvent[]

  @@index([organizationId])
}

// provider: "custom_api" | "custom_webhook" | "js_sdk" | "woocommerce" | "shopify"
// status: "connected" | "warning" | "disconnected"
model Integration {
  id                 String    @id @default(cuid())
  storeId            String
  provider           String
  status             String    @default("disconnected")
  lastRequestAt      DateTime?
  lastWebhookAt      DateTime?
  lastSyncAt         DateTime?
  failedRequestCount Int       @default(0)
  config             String    @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  store           Store            @relation(fields: [storeId], references: [id])
  apiKeys         ApiKey[]
  integrationLogs IntegrationLog[]

  @@index([storeId])
}

// scopes: JSON array of "orders:write" | "products:write" | "inventory:write" | "customers:write" | "read"
model ApiKey {
  id            String    @id @default(cuid())
  storeId       String
  integrationId String
  name          String
  keyPrefix     String
  keyHash       String    @unique
  scopes        String    @default("[]")
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  store       Store       @relation(fields: [storeId], references: [id])
  integration Integration @relation(fields: [integrationId], references: [id])

  @@index([storeId])
  @@index([integrationId])
}

model WebhookEndpoint {
  id               String   @id @default(cuid())
  storeId          String
  // AES-256-GCM ciphertext (see src/lib/crypto.ts), NOT a one-way hash —
  // verifying an inbound HMAC signature requires recovering the plaintext
  // secret, unlike API keys/passwords which only need hash comparison.
  secretCiphertext String
  description      String   @default("Nexora inbound webhook secret")
  createdAt        DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

// eventType: "order.created" | "order.updated" | "order.cancelled" |
//            "product.created" | "product.updated" | "product.deleted" |
//            "inventory.updated" | "customer.created" | "customer.updated"
// status: "received" | "processed" | "failed" | "duplicate"
model WebhookEvent {
  id         String   @id @default(cuid())
  storeId    String
  eventId    String
  eventType  String
  payload    String
  status     String   @default("received")
  receivedAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, eventId])
  @@index([storeId])
}

// status: "pending" | "confirmed" | "preparing" | "shipped" | "delivered" | "cancelled"
// paymentStatus: "unpaid" | "paid" | "refunded"
model Order {
  id              String   @id @default(cuid())
  storeId         String
  externalId      String
  customerId      String?
  customerName    String
  status          String   @default("pending")
  paymentStatus   String   @default("unpaid")
  total           Int
  currency        String   @default("NGN")
  deliveryAddress String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store    Store       @relation(fields: [storeId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@unique([storeId, externalId])
  @@index([storeId])
  @@index([storeId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  quantity  Int
  price     Int

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// status: "active" | "draft" | "archived"
// images: JSON array of URLs (http(s):// or a data: URL from a
// drag/drop or device upload — see docs/API_CONTRACTS.md "Products").
// imageUrl mirrors images[0] for backward compatibility with older
// integrations/tests that only ever set a single cover image.
// categories: JSON array of strings.
// attributes: JSON object of developer-defined extra fields (primitive
// values only — see src/lib/validation.ts productAttributesSchema).
model Product {
  id          String   @id @default(cuid())
  storeId     String
  sku         String
  name        String
  description String?
  price       Int
  currency    String   @default("NGN")
  imageUrl    String?
  images      String   @default("[]")
  categories  String   @default("[]")
  status      String   @default("active")
  attributes  String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // The sender's own `occurred_at` from the last webhook sync write that
  // was actually applied (see src/lib/productService.ts). Null for
  // products never synced via webhook, or synced without an occurred_at.
  // This is deliberately separate from `updatedAt`, which stays Nexora's
  // own local write timestamp and is never used for staleness ordering.
  sourceUpdatedAt DateTime?
  // Outbound push state — see src/lib/productPushService.ts.
  // pushStatus: "not_pushed" | "pushing" | "pushed" | "failed" |
  //             "unverifiable" (destination confirmation could not be
  //             obtained — never treated as success) | "unsupported"
  // pushDestinationRef: an opaque identifier the destination returned for
  // this product (e.g. its remote product id) — never a secret/credential.
  pushStatus         String    @default("not_pushed")
  lastPushedAt       DateTime?
  lastPushError      String?
  pushDestinationRef String?

  store      Store            @relation(fields: [storeId], references: [id])
  inventory  Inventory?
  orderItems OrderItem[]
  variants   ProductVariant[]

  @@unique([storeId, sku])
  @@index([storeId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String?
  price     Int?
  quantity  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Inventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  storeId           String
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model Customer {
  id         String   @id @default(cuid())
  storeId    String
  externalId String
  name       String
  email      String?
  phone      String?
  createdAt  DateTime @default(now())

  store  Store   @relation(fields: [storeId], references: [id])
  orders Order[]

  @@unique([storeId, externalId])
  @@index([storeId])
}

// severity: "info" | "warning" | "critical"
model Notification {
  id             String    @id @default(cuid())
  organizationId String
  storeId        String?
  type           String
  title          String
  body           String
  severity       String    @default("info")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store?       @relation(fields: [storeId], references: [id])

  @@index([organizationId])
  @@index([organizationId, readAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId])
  @@index([actorUserId])
}

// Automatic observability, not a user-submitted form — see
// docs/API_CONTRACTS.md "Monitoring". A connected website/app (via the JS
// SDK's automatic capture, or a backend using its API key) reports raw
// occurrences; Nexora groups them into a deduplicated MonitoringIssue by
// fingerprint (see src/lib/monitoring.ts).
//
// type: "js_error" | "unhandled_rejection" | "console_error" |
//       "network_error" | "crash"
// severity: "info" | "warning" | "error" | "critical"
// status: "unresolved" | "resolved" | "ignored" — a new occurrence on a
// resolved issue automatically reopens it (regression).
model MonitoringIssue {
  id              String   @id @default(cuid())
  organizationId  String
  storeId         String
  fingerprint     String
  type            String
  message         String
  stack           String?
  route           String?
  severity        String   @default("error")
  status          String   @default("unresolved")
  occurrenceCount Int      @default(1)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  lastBrowser     String?
  lastStatusCode  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  store        Store             @relation(fields: [storeId], references: [id])
  events       MonitoringEvent[]

  @@unique([storeId, fingerprint])
  @@index([organizationId])
  @@index([storeId, status])
}

// One row per raw occurrence reported for a MonitoringIssue — diagnostics
// is a strict allow-list (route, viewport, browser/user agent, app
// version) validated by src/lib/validation.ts monitoringEventSchema, which
// silently drops any other key so API keys/webhook secrets/passwords/
// session tokens can never be persisted through it.
model MonitoringEvent {
  id          String   @id @default(cuid())
  issueId     String
  storeId     String
  type        String
  message     String
  stack       String?
  route       String?
  statusCode  Int?
  browser     String?
  diagnostics String   @default("{}")
  occurredAt  DateTime @default(now())

  issue MonitoringIssue @relation(fields: [issueId], references: [id])
  store Store           @relation(fields: [storeId], references: [id])

  @@index([issueId])
  @@index([storeId])
}

// direction: "inbound" | "outbound"; level: "info" | "warning" | "error"
model IntegrationLog {
  id            String   @id @default(cuid())
  storeId       String
  integrationId String?
  direction     String
  level         String   @default("info")
  message       String
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())

  store       Store        @relation(fields: [storeId], references: [id])
  integration Integration? @relation(fields: [integrationId], references: [id])

  @@index([storeId])
  @@index([integrationId])
}
