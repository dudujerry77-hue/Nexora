# Copy to .env for local development.

# SQLite for zero-setup local dev. For production, point this at Postgres
# and switch the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Used to sign dashboard session JWTs. Generate a real secret with:
#   openssl rand -base64 48
NEXORA_JWT_SECRET="dev-only-insecure-secret-change-me"

# Used to encrypt webhook signing secrets at rest (src/lib/crypto.ts).
# Generate a real one with: openssl rand -base64 48
NEXORA_ENCRYPTION_KEY="dev-only-insecure-encryption-key-change-me"
